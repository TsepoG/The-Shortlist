# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — see CLAUDE.md's Commands section.
#
# Two consumers read these:
#   - docker-compose.yml reads POSTGRES_USER/PASSWORD/DB directly (Compose
#     auto-loads a .env file in this same directory).
#   - The Python app (src/shortlist/config.py) reads DATABASE_URL and
#     SHORTLIST_SEC_USER_AGENT via python-dotenv, so any command
#     (uv run pytest, uv run alembic, an ingest script) picks them up too.

# --- Local Postgres (docker-compose.yml) ------------------------------------
# Throwaway local dev credentials — not a production secret, but still kept
# out of version control on principle.
POSTGRES_USER=shortlist
POSTGRES_PASSWORD=shortlist
POSTGRES_DB=shortlist_test

# --- App database connection (src/shortlist/config.py) ----------------------
# Must be kept in sync with the three POSTGRES_* values above and with
# docker-compose.yml's published port (5433 by default — see that file's
# comment on why it isn't 5432 on some machines). Required; no default.
DATABASE_URL=postgresql+psycopg://shortlist:shortlist@localhost:5433/shortlist_test

# --- SEC EDGAR compliance (PHASE_1.md §1) -----------------------------------
# A descriptive User-Agent with a REAL, working contact address — SEC EDGAR
# requires this and may block requests without one. Only needed for ingestion
# commands (backfill, incremental update), not for the test suite. Required;
# no default; never commit a real address to .env.example.
SHORTLIST_SEC_USER_AGENT=Your Name or Org <you@example.com>

# --- Price provider (PHASE_2.md §1) -----------------------------------------
# A descriptive User-Agent for the price provider. NOTE: unlike the SEC value
# above, this is a defensive convention, not a published compliance
# requirement — the provider's endpoint is undocumented and states no
# identification policy. It is required because the endpoint returns 404 to a
# bare client, and because contacting a service on sufferance under an
# identifiable agent is good practice. See docs/phases/PHASE_2_NOTES.md §0.3.
# Only needed for price ingestion, not for the test suite. Required; no default.
SHORTLIST_PRICE_USER_AGENT=Your Name or Org <you@example.com>
